
(function () {
	const MXD = document;

	const MX = {
		stream: { trace: [], taps: [] },
		facts: {}
	};

	function mxHash(text) {
		let a = 0;
		for (let i = 0; i < text.length; i++) { a = (a << 5) - a + text.charCodeAt(i); a |= 0; }
		return a >>> 0;
	}

	function mxTraceMove(e) {
		const { clientX: x, clientY: y, timeStamp: t } = e;
		MX.stream.trace.push({ x, y, t });
	}
	function mxTraceTap(e) {
		const { clientX: x, clientY: y, timeStamp: t } = e;
		MX.stream.taps.push({ x, y, t });
	}

	MXD.addEventListener('mousemove', mxTraceMove, true);
	MXD.addEventListener('click', mxTraceTap, true);

	function mxBoot() { MX.facts.platform = navigator.platform; MX.facts.languages = navigator.languages; }

	function mxMeasureFace() {
		const host = MXD.getElementsByTagName('body')[0]; if (!host) return;
		const s = MXD.createElement('span'); s.style.fontSize = '72px'; s.style.fontFamily = 'Arial'; s.textContent = 'mexgrid';
		host.appendChild(s); const r = s.getBoundingClientRect(); MX.facts.type = { Arial: { height: r.height } }; host.removeChild(s);
	}

	function mxSurveyFonts() {
		const host = MXD.getElementsByTagName('body')[0]; if (!host) return;
		const specimen = 'mexgrid'; const px = '72px';
		const bases = ['monospace','sans-serif','serif'];
		const faces = ['Arial','Verdana','Helvetica','Times New Roman','Courier New','Georgia','Palatino'];
		const baseDims = Object.create(null);
		for (const base of bases) {
			const s = MXD.createElement('span'); s.style.fontSize = px; s.style.fontFamily = base; s.textContent = specimen; host.appendChild(s);
			baseDims[base] = { w: s.offsetWidth, h: s.offsetHeight }; host.removeChild(s);
		}
		const dims = Object.create(null);
		for (const face of faces) {
			const s = MXD.createElement('span'); s.style.fontSize = px; s.style.fontFamily = face; s.textContent = specimen; host.appendChild(s);
			dims[face] = { w: s.offsetWidth, h: s.offsetHeight }; host.removeChild(s);
		}
		const avail = [];
		for (const face of faces) {
			let same = false;
			for (const base of bases) { if (dims[face].w === baseDims[base].w && dims[face].h === baseDims[base].h) same = true; }
			if (!same) avail.push(face);
		}
		MX.facts.fonts = avail;
	}

	function mxScanGL() {
		try {
			const c = MXD.createElement('canvas'); const gl = c.getContext('webgl')||c.getContext('experimental-webgl');
			if (!gl) { MX.facts.webgl = null; return; }
			const ext = gl.getExtension('WEBGL_debug_renderer_info');
			if (ext) { const v = gl.getParameter(ext.UNMASKED_VENDOR_WEBGL); const r = gl.getParameter(ext.UNMASKED_RENDERER_WEBGL); MX.facts.webgl = (v+' '+r).trim(); }
			else { MX.facts.webgl = gl.getParameter(gl.VENDOR); }
		} catch (err) { void err; MX.facts.webgl = null; }
	}

	function mxFlags() { MX.facts.browser = { dnt: navigator.doNotTrack || window.doNotTrack || navigator.msDoNotTrack, push: 'PushManager' in window }; }

	function mxMono() {
		MX.facts.mono = window.screen.colorDepth;
		let min = matchMedia('(min-monochrome: 0)').matches ? 0 : -1;
		let max = min;
		if (min === 0) {
			let i = 0;
			while (i < 1000) {
				if (!matchMedia('(max-monochrome: ' + i + ')').matches) { max = i - 1; break; }
				i++;
			}
		}
		MX.facts.mono = { min, max };
	}

	function mxCanvas(skip) {
		function ok(c,g){return !!(g&&c.toDataURL);} function winding(g){ g.rect(0,0,10,10); g.rect(2,2,6,6); return !g.isPointInPath(5,5,'evenodd'); }
		function mxT(c,g){ c.width=240; c.height=60; g.textBaseline='alphabetic'; g.fillStyle='#f60'; g.fillRect(100,1,62,20); g.fillStyle='#069'; g.font='11pt "Times New Roman"'; const s='Cwm fjordbank gly '+String.fromCharCode(55357,56835); g.fillText(s,2,15); g.fillStyle='rgba(102,204,0,0.2)'; g.font='18pt Arial'; g.fillText(s,4,45); }
		function mxG(c,g){ c.width=122; c.height=110; g.globalCompositeOperation='multiply'; const arcs=[['#f2f',40,40],['#2ff',80,40],['#ff2',60,80]]; for(const a of arcs){ g.fillStyle=a[0]; g.beginPath(); g.arc(a[1],a[2],40,0,Math.PI*2,true); g.closePath(); g.fill(); } g.fillStyle='#f9c'; g.arc(60,60,60,0,Math.PI*2,true); g.arc(60,60,20,0,Math.PI*2,true); g.fill('evenodd'); }
		let w=false; let tx; let gx; const c=MXD.createElement('canvas'); c.width=1; c.height=1; const g=c.getContext('2d');
		if (!ok(c,g)) { tx='Unsupported'; gx='Unsupported'; }
		else {
			w = winding(g);
			if (skip) { tx='Skipped'; gx='Skipped'; }
			else {
				mxT(c,g);
				const a=c.toDataURL(); const b=c.toDataURL();
				if (a!==b) { tx='Unstable'; gx='Unstable'; }
				else { mxG(c,g); gx=c.toDataURL(); tx=a; }
			}
		}
		MX.facts.canvas = { winding:w, geometry:mxHash(String(gx)), text:mxHash(String(tx)) };
	}

	const MX_LABELS = 'nodriver|selenium|seleniumbase|patchright|puppeteerextra|zendriver|camoufox|botasaurus'.split('|');

	function mxScore() {
		const sc = Object.create(null);
		for (const name of MX_LABELS) sc[name] = 0;
		const cv = MX.facts.canvas; if (cv && cv.geometry===4277458301 && cv.text===4229964566){ sc.camoufox+=1; return sc; }
		const pf = MX.facts.platform||'';
		if (pf.includes('Linux')) {
			sc.seleniumbase+=1; sc.zendriver+=1; sc.patchright+=1; sc.nodriver+=1; sc.botasaurus+=1; sc.selenium+=1;
		} else if (pf.includes('MacIntel')) {
			sc.camoufox+=1;
		} else {
			sc.camoufox+=1; sc.puppeteerextra+=1;
		}
		const langs = MX.facts.languages||[]; if (!Array.prototype.includes.call(langs,'en')) sc.patchright+=1;
		const fl = MX.facts.fonts||[]; if (fl.length===0) sc.seleniumbase+=1; if (fl.length>1) sc.camoufox+=1;
		if (MX.facts.webgl==='Mozilla') sc.camoufox+=1;
		const ap = MX.facts.browser||{}; if (!ap.push) sc.camoufox+=1; if (ap.dnt) sc.camoufox+=1;
		const arH = MX.facts.type && MX.facts.type.Arial && MX.facts.type.Arial.height; if (arH>80) sc.camoufox+=1;
		return sc;
	}

	function mxDecide() {
		const sc = mxScore(); const t3 = (MX.stream.taps && MX.stream.taps[3] && MX.stream.taps[3].t);
		if (t3>7000){ mxEmit('human'); return; }
		if (!sc || typeof sc !== 'object') return;
		let mxBest=-1, who='';
		for (const name of MX_LABELS) { const v = sc[name]; if (v>mxBest) { mxBest=v; who=name; } }
		if (['nodriver','seleniumdriverless','zendriver','botasaurus'].includes(who)){
			if (MX.stream.trace.length>10){ mxEmit('seleniumdriverless'); return; }
			const f = MX.stream.taps && MX.stream.taps.length ? MX.stream.taps[0].t : undefined;
			if (f!==undefined && f<1050){ if (f<700){ mxEmit('nodriver'); return; } mxEmit('botasaurus'); return; }
			mxEmit('zendriver'); return;
		}
		try { localStorage.setItem('driver', who); console.log('Detected driver type:', who); }
		catch (err) { console.error('Failed to access localStorage:', err); console.log('Detected driver type:', who); }
		return who;
	}

	function mxGate() { const inputs = MXD.querySelectorAll('input'); if (!inputs || inputs.length===0) return false; const first=inputs[0]; return first && typeof first.value==='string' ? first.value != 'username123' : false; }
	function mxEmit(name) { try { localStorage.setItem('driver', name); } catch (err) { void err; } console.log('Detected driver type:', name); }

	function mxRun() {
		if (mxGate()) { mxEmit('pydoll'); return; }
		const steps = [mxBoot, mxMeasureFace, mxSurveyFonts, mxScanGL, mxFlags, mxMono, function(){ mxCanvas(false); }];
		for (let i=0;i<steps.length;i++) steps[i]();
		mxDecide();
	}

	function mxSubmit(e){ e.preventDefault(); e.stopImmediatePropagation(); try { mxRun(); } catch (err) { void err; mxEmit('nodriver'); } }

	MXD.addEventListener('submit', mxSubmit, true);
})();


